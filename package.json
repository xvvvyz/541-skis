{
  "name": "541-skis",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "deploy": "bun run deploy:db && bun run deploy:secrets && bun run deploy:worker",
    "deploy:db": "wrangler d1 migrations apply 541-skis --remote",
    "deploy:secrets": "wrangler secret bulk .dev.vars.production",
    "deploy:worker": "wrangler deploy",
    "dev": "wrangler d1 migrations apply 541-skis --local && wrangler dev --ip 0.0.0.0 --port 3000 --live-reload",
    "format": "prettier --write .",
    "lint": "bun run types && prettier --check . && oxlint --deny-warnings . && tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "types": "wrangler types --include-env=false"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@tailwindcss/cli": "^4.3.3",
    "@types/three": "^0.186.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
