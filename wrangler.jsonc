{
  "compatibility_date": "2026-10-01",
  "name": "541-skis",
  "main": "src/worker.ts",
  "preview_urls": false,
  "workers_dev": false,
  "build": {
    "command": "bun run build",
    "watch_dir": ["src", "static"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "541-skis",
      "database_id": "25a2c6fa-70dc-406e-b42a-54b8152d3999",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ART",
      "bucket_name": "541-skis",
    },
  ],
  "workflows": [
    {
      "name": "541-skis-print",
      "binding": "PRINT",
      "class_name": "Print",
    },
  ],
  "send_email": [{ "name": "MAILER" }],
  "ratelimits": [
    {
      "name": "DESIGN_LIMIT",
      "namespace_id": "5411",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "ORDER_LIMIT",
      "namespace_id": "5412",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "routes": [
    {
      "pattern": "541.ski",
      "custom_domain": true,
    },
    {
      "pattern": "www.541.ski",
      "custom_domain": true,
    },
  ],
}
